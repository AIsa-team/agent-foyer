{
  "name": "agent-foyer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "smoke": "node scripts/smoke.ts",
    "smoke:data": "node scripts/smoke-data.ts",
    "test": "pnpm typecheck && pnpm smoke:data && pnpm smoke:oidc",
    "smoke:oidc": "node scripts/smoke-oidc.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "http-proxy-3": "^2.0.1",
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "license": "Apache-2.0",
  "description": "An agent-native company hub on Lark: an app square, a Skill market, data boards and an MCP server for your agents."
}
