# ---- Required in production ----
# Public URL of the hub (the Lark workplace entry points here)
HUB_URL=https://hub.example.com
# Apps live at https://<slug>.<APPS_DOMAIN>. A separate registrable domain is safest (apps then cannot read or set
# cookies on the hub's domain); a subdomain like apps.example.com also works. See SECURITY.md.
APPS_DOMAIN=example.net
# Names under APPS_DOMAIN that already have their own DNS records (they shadow the wildcard), comma separated
RESERVED_SLUGS=www,mail
# Long random string: signs download links and encrypts stored secrets. Generate with: openssl rand -base64 48
HUB_SECRET=

# ---- Sign-in: Lark (everything) or OpenID Connect (the core hub) ----
# lark | oidc | dev; inferred from LARK_APP_ID, then OIDC_ISSUER, else the local dev login
# AUTH_PROVIDER=
# Lark custom app (open.larksuite.com → Developer Console, see docs/LARK_SETUP.md)
LARK_APP_ID=
LARK_APP_SECRET=
# larksuite.com for Lark, feishu.cn for Feishu
LARK_DOMAIN=larksuite.com
# Or any OpenID Connect provider (Google Workspace, Microsoft Entra ID, Okta, Keycloak…), see docs/OIDC_SETUP.md
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Google
# Email domains allowed to sign in (required for Google, recommended for everyone)
# OIDC_ALLOWED_DOMAINS=example.com

# Comma separated emails or Lark open_ids that are always admins (the first person to log in is admin too)
HUB_ADMINS=you@example.com

# ---- Email drafts from apps (saved in each person's own mailbox, never sent) ----
# google (Gmail, needs the OAuth client below, see docs/GOOGLE_MAIL.md) | lark (Lark Mail) | none
# MAIL_DRAFTS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Your company ----
# Shown in the UI ("Acme Hub") and in messages the hub sends
COMPANY_NAME=Acme
# Name agents register the hub's MCP server under (claude mcp add <name> ...)
HUB_MCP_NAME=agent-hub
# Folder with your own logo.svg, app-icon.svg and motif.svg (inside the container, e.g. /data/brand).
# Missing files fall back to the built-in neutral ones.
# HUB_BRAND_DIR=/data/brand
# Brand colour over the default theme (hex)
# HUB_ACCENT=#F76918
# Skills that hold your design rules; agents are told to install them before building UI (comma separated slugs)
# HUB_DESIGN_SKILLS=web-design,slides
# Time zone for quiet hours, digests and date buckets
HUB_TIMEZONE=UTC

# ---- Docker (deploy/docker-compose.yml) ----
# Image and container name of the hub itself
# HUB_IMAGE=agent-hub
# HUB_CONTAINER=agent-hub
# Absolute path of the hub data folder ON THE HOST (needed to mount per-app /data volumes)
HOST_DATA_DIR=/srv/agent-hub/data
APP_MEMORY_LIMIT=512m
APP_CPU_LIMIT=1
# Cloudflare's free plan rejects request bodies over 100 MB
MAX_UPLOAD_MB=95
# Host port the hub listens on (127.0.0.1 only; nginx/Caddy proxies to it)
HUB_PORT=8090
