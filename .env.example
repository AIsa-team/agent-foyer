# ---- Required in production ----
# Public URL of the hub
HUB_URL=https://hub.example.com
# Apps live at https://<slug>.<APPS_DOMAIN>. A separate registrable domain is safest (apps then cannot read or set
# cookies on the hub's domain); a subdomain like apps.example.com also works. See SECURITY.md.
APPS_DOMAIN=example.net
# Names under APPS_DOMAIN that already have their own DNS records (they shadow the wildcard), comma separated
RESERVED_SLUGS=www,mail
# Long random string: signs download links and encrypts stored secrets. Generate with: openssl rand -base64 48
HUB_SECRET=

# ---- Sign-in: Lark (everything) or OpenID Connect (the core hub) ----
# lark | oidc | dev; inferred from LARK_APP_ID, then OIDC_ISSUER, else the local dev login
# AUTH_PROVIDER=
# Lark custom app (open.larksuite.com → Developer Console, see docs/LARK_SETUP.md)
LARK_APP_ID=
LARK_APP_SECRET=
# larksuite.com for Lark, feishu.cn for Feishu
LARK_DOMAIN=larksuite.com
# Confirm messages agents send as people on a card in Lark, instead of in the agent's app (needs the card callback, docs/LARK_SETUP.md)
# LARK_CONFIRM_CARDS=on
# Or any OpenID Connect provider (Google Workspace, Microsoft Entra ID, Okta, Keycloak…), see docs/OIDC_SETUP.md
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Google
# Email domains allowed to sign in (required for Google, recommended for everyone)
# OIDC_ALLOWED_DOMAINS=example.com
# Scopes asked for at sign-in
# OIDC_SCOPES=openid profile email

# Comma separated emails or Lark open_ids that are always admins (the first person to log in is admin too)
HUB_ADMINS=you@example.com

# ---- Email drafts from apps (saved in each person's own mailbox, never sent) ----
# google (Gmail, needs the OAuth client below, see docs/GOOGLE_MAIL.md) | lark (Lark Mail) | none
# MAIL_DRAFTS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- GitHub (agents read what someone did, e.g. for the daily report; see docs/GITHUB.md) ----
# GITHUB_ORG=
# GITHUB_APP_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# PEM text, or a path to the .pem file (relative paths are inside the data folder)
# GITHUB_APP_PRIVATE_KEY=github-app.pem
# Optional: GitHub pushes to /hooks/github, so branch work without a pull request is counted too
# GITHUB_WEBHOOK_SECRET=

# ---- Linear (the Projects page; each person connects their own Linear, read only) ----
# Create an OAuth application in Linear (Settings → API → OAuth applications) with the callback URL
# https://<your hub>/auth/linear/callback, then set:
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# ---- Your hub ----
# The name shown in the UI ("Acme Hub") and in messages the hub sends (a company, a team, a community…)
COMPANY_NAME=Acme
# Name agents register the hub's MCP server under (claude mcp add <name> ...)
HUB_MCP_NAME=agent-foyer
# Folder with your own logo.svg, app-icon.svg and motif.svg (inside the container, e.g. /data/brand).
# Missing files fall back to the built-in neutral ones.
# HUB_BRAND_DIR=/data/brand
# Brand colour over the default theme (hex)
# HUB_ACCENT=#4F46E5
# Skills that hold your design rules; agents are told to install them before building UI (comma separated slugs)
# HUB_DESIGN_SKILLS=web-design,slides
# Time zone for quiet hours, digests and date buckets
HUB_TIMEZONE=UTC
# Language for people who have not picked one (a shipped catalogue: en, zh-CN)
# DEFAULT_LOCALE=en

# ---- Alerts and data checks (optional) ----
# At most one message per alert rule in this many minutes; flips back and forth inside it are merged
# ALERT_COOLDOWN_MINUTES=360
# No messages in these hours (hub time zone), held until morning; "off" to send at any time
# ALERT_QUIET_HOURS=22-9
# How often data checks run on their own
# CHECKS_EVERY_HOURS=6

# ---- Docker (deploy/docker-compose.yml) ----
# Image and container name of the hub itself
# HUB_IMAGE=agent-foyer
# HUB_CONTAINER=agent-foyer
# Absolute path of the hub data folder ON THE HOST (needed to mount per-app /data volumes)
HOST_DATA_DIR=/srv/agent-foyer/data
APP_MEMORY_LIMIT=512m
APP_CPU_LIMIT=1
# Cloudflare's free plan rejects request bodies over 100 MB
MAX_UPLOAD_MB=95
# Rows read through a data connection (Metabase…) that are on a page, a board or an alert are read again in the
# background this often. Such queries often run on a production database; keep it modest.
# CONNECTOR_REFRESH_MINUTES=30
# Host port the hub listens on (127.0.0.1 only; nginx/Caddy proxies to it)
HUB_PORT=8090
# How the hub reaches app containers: network (the hub runs in Docker, as with deploy/docker-compose.yml) or port
# (the hub runs on the host, e.g. local development)
# APP_UPSTREAM_MODE=network

# ---- Running the hub directly (without deploy/docker-compose.yml) ----
# PORT=8080
# DATA_DIR=./data
# http or https for app links; defaults to the scheme of HUB_URL
# APPS_PROTOCOL=https
